#!/bin/bash
set -euo pipefail
exec > >(tee -a /var/log/site-bootstrap.log) 2>&1

echo "bootstrap start $(date -u +%FT%TZ) artifact=${zip_hash}"

if ! command -v unzip >/dev/null 2>&1; then
  dnf install -y unzip
fi

mkdir -p /opt/site
aws s3 cp "s3://${bucket}/${key}" /tmp/site.zip --region "${region}"
unzip -o /tmp/site.zip -d /opt/site
rm -f /tmp/site.zip

id site >/dev/null 2>&1 || useradd --system --no-create-home --shell /sbin/nologin site
chown -R site:site /opt/site
chmod +x /opt/site/site

mkdir -p /var/lib/site/certs
aws s3 sync "s3://${bucket}/certs/" /var/lib/site/certs --region "${region}" || true
chown -R site:site /var/lib/site
chmod 700 /var/lib/site/certs

cat >/etc/systemd/system/site.service <<'UNIT'
[Unit]
Description=site
After=network-online.target
Wants=network-online.target

[Service]
User=site
WorkingDirectory=/opt/site
ExecStart=/opt/site/site serve
Environment=SITE_ADDR=:80
Environment=SITE_HTTPS_ADDR=:443
Environment=SITE_TLS_DOMAINS=${tls_domains}
Environment=SITE_TLS_EMAIL=${tls_email}
Environment=SITE_TLS_CACHE_DIR=/var/lib/site/certs
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
UNIT

cat >/etc/systemd/system/site-certs-sync.service <<'UNIT'
[Unit]
Description=site certs backup

[Service]
Type=oneshot
ExecStart=/usr/bin/aws s3 sync /var/lib/site/certs "s3://${bucket}/certs/" --region ${region}
UNIT

cat >/etc/systemd/system/site-certs-sync.timer <<'UNIT'
[Unit]
Description=site certs backup timer

[Timer]
OnBootSec=5min
OnUnitActiveSec=1h

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now site.service
systemctl enable --now site-certs-sync.timer

echo "bootstrap done $(date -u +%FT%TZ)"
