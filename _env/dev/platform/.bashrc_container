alias sql_gen="cd /platform/ && sqlc generate"

sync_certs() {
    cp /root/server.crt /platform/api/_env/server.crt
    cp /root/server.key /platform/api/_env/server.key
    cp /root/ca.crt /platform/api/_env/ca.crt

    cp /root/cli-client.crt /platform/cmd/beiz/_env/cli-client.crt
    cp /root/cli-client.key /platform/cmd/beiz/_env/cli-client.key
    cp /root/ca.crt /platform/cmd/beiz/_env/ca.crt
}