set shell := ["bash", "-euo", "pipefail", "-c"]

out := "deploy/static"
port := "8080"
docker := "_emv/docker"
css_in := "web/styles/main.css"
css_out := "web/static/css/style.css"
dev_img := "main_site-dev"
dev_ctx := docker + "/dev"
dev_cache := "main_site-go"
web_img := "main_site-preview"
web_ctx := docker + "/site-html"
web_name := "main_site-preview"
dev_run := "docker run --rm -v \"" + justfile_directory() + ":/src\" -v " + dev_cache + ":/go " + dev_img

# image policy: missing (build only if tag absent) | always (rebuild) | never (require prebuilt)
img := "missing"

default:
    @just --list

# --- images

[private]
ensure-img tag ctx:
    #!/usr/bin/env bash
    set -euo pipefail
    have() { docker image inspect "{{tag}}" > /dev/null 2>&1; }
    case "{{img}}" in
      always)  docker build -t "{{tag}}" "{{ctx}}" ;;
      missing) have || docker build -t "{{tag}}" "{{ctx}}" ;;
      never)   have || { echo "image {{tag}} not found - build it first (just img=always ...)" >&2; exit 1; } ;;
      *)       echo "unknown img policy '{{img}}' (use missing|always|never)" >&2; exit 1 ;;
    esac

# force (re)build of the dev image
dev-img:
    docker build -t {{dev_img}} {{dev_ctx}}

# force (re)build of the preview image
preview-img:
    docker build -t {{web_img}} {{web_ctx}}

# --- go

tidy:
    go mod tidy

fmt:
    gofmt -w .

lint:
    go vet ./...
    test -z "$(gofmt -l .)"

# --- dev container

dev-shell: (ensure-img dev_img dev_ctx)
    docker run --rm -it -v "{{justfile_directory()}}:/src" -v {{dev_cache}}:/go {{dev_img}}

# build tailwind css from web/**/*.html into web/static/css/style.css
style: (ensure-img dev_img dev_ctx)
    {{dev_run}} tailwindcss -i {{css_in}} -o {{css_out}} --minify

# build the static site into deploy/static in the dev container
gen base_url="": style
    {{dev_run}} go run . --out {{out}} {{ if base_url != "" { "--base-url " + base_url } else { "" } }}

# --- site-html container

# serve deploy/gen with nginx on the given port
preview port=port: (ensure-img web_img web_ctx)
    docker rm -f {{web_name}} > /dev/null 2>&1 || true
    docker run -d --name {{web_name}} -p {{port}}:80 \
        -v "{{justfile_directory()}}/{{out}}:/var/www/sites/main:ro" {{web_img}}
    @echo "http://localhost:{{port}}"

# restart the preview container (starts it when missing)
restart port=port:
    #!/usr/bin/env bash
    set -euo pipefail
    if docker container inspect {{web_name}} > /dev/null 2>&1; then
      docker restart {{web_name}} > /dev/null
      echo "http://localhost:{{port}}"
    else
      just preview {{port}}
    fi

stop:
    docker rm -f {{web_name}}