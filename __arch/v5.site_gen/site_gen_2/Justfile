set shell := ["bash", "-euo", "pipefail", "-c"]

bin := "bin/site"
out := "deploy/static"
dist := "dist"
tf := "deploy/terraform"
port := "8080"

default:
    @just --list

# --- go

tidy:
    go mod tidy

fmt:
    gofmt -w .

lint:
    go vet ./...
    test -z "$(gofmt -l .)"

build:
    go build -o {{bin}} .

# build the static site into deploy/static
site base_url="": build
    ./{{bin}} --out {{out}} {{ if base_url != "" { "--base-url " + base_url } else { "" } }}

# serve deploy/static locally to preview the build
preview port=port: site
    python3 -m http.server {{port}} -d {{out}}

# --- dist

dist: site
    rm -rf {{dist}}
    mkdir -p {{dist}}
    cp -R {{out}}/. {{dist}}/

clean:
    rm -rf bin {{out}} {{dist}} {{tf}}/.build

# --- terraform

tf-init:
    terraform -chdir={{tf}} init

tf-fmt:
    terraform -chdir={{tf}} fmt

tf-validate:
    terraform -chdir={{tf}} validate

tf-plan: dist
    terraform -chdir={{tf}} plan

deploy: dist
    terraform -chdir={{tf}} apply

destroy:
    terraform -chdir={{tf}} destroy

url:
    terraform -chdir={{tf}} output -raw url

id:
    @terraform -chdir={{tf}} output -raw instance_id

ssh:
    ssh "$(terraform -chdir={{tf}} output -raw instance_id)"

dns:
    terraform -chdir={{tf}} output hostnames
    terraform -chdir={{tf}} output public_ip

ssm:
    aws ssm start-session --target "$(terraform -chdir={{tf}} output -raw instance_id)"
